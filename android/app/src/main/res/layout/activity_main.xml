<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. 底层：视频播放器 -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/videoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false" />

    <!-- 视频缓冲指示器 -->
    <ProgressBar
        android:id="@+id/progressBuffering"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent"
        android:visibility="gone" />

    <!-- 2. OSD 底栏 (切换频道时显示的信息) -->
    <LinearLayout
        android:id="@+id/layoutOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_osd_gradient"
        android:orientation="vertical"
        android:paddingHorizontal="48dp"
        android:paddingBottom="32dp"
        android:paddingTop="64dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            
            <TextView
                android:id="@+id/tvOsdChannelNum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="001"
                android:textColor="@color/accent"
                android:textSize="36sp"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvOsdChannelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CCTV-1 综合"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>

            <!-- 右侧网速、时间、编码等 -->
            <TextView
                android:id="@+id/tvOsdInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#AAAAAA"
                android:textSize="16sp"
                android:text="1080P | H264 | AC3" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOsdEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正在播放: 精彩节目"
            android:textColor="#DDDDDD"
            android:textSize="18sp"
            android:layout_marginTop="8dp"/>
            
        <ProgressBar
            android:id="@+id/progressEpg"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:progress="30"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="#44FFFFFF"/>
    </LinearLayout>

    <!-- 3. 左侧侧滑菜单 (Zapping Menu) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutZappingMenu"
        android:layout_width="450dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#CC000000"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- 左侧：分组列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGroups"
            android:layout_width="150dp"
            android:layout_height="0dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:clipToPadding="false"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 分隔线 -->
        <View
            android:id="@+id/divider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="#33FFFFFF"
            app:layout_constraintStart_toEndOf="@id/rvGroups"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginVertical="32dp"/>

        <!-- 右侧：频道列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChannels"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:clipToPadding="false"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
            
        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/accent"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvEmptyText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_channels"
            android:textColor="#888888"
            app:layout_constraintStart_toEndOf="@id/divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. 右侧侧滑设置菜单 (Settings Menu) -->
    <LinearLayout
        android:id="@+id/layoutSettingsMenu"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        tools:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务器地址"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etSettingsUrl"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#33FFFFFF"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="16dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="24dp"
            android:nextFocusDown="@+id/sbSettingsCache" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网络缓存时长:"
                android:textColor="#AAAAAA"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/tvSettingsCacheValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 1.5 秒"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sbSettingsCache"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="45"
            android:progress="10"
            android:layout_marginBottom="32dp"
            android:nextFocusUp="@+id/etSettingsUrl"
            android:nextFocusDown="@+id/btnSettingsSave" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">
            
            <Button
                android:id="@+id/btnSettingsCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:textColor="#AAAAAA"
                android:background="@android:color/transparent"
                android:layout_marginEnd="16dp"
                android:nextFocusUp="@+id/sbSettingsCache" />

            <Button
                android:id="@+id/btnSettingsSave"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="保存"
                android:backgroundTint="@color/accent"
                android:textColor="#000000"
                android:nextFocusUp="@+id/sbSettingsCache" />
        </LinearLayout>
        
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        
        <!-- 关于信息 -->
        <TextView
            android:id="@+id/tvSettingsInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />
            
    </LinearLayout>

    <!-- 5. 顶层：授权/启动等待界面 -->
    <LinearLayout
        android:id="@+id/layoutAuthWaiting"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF000000"
        android:padding="48dp"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_tv"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvAuthStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在连接服务器..."
            android:textColor="#AAAAAA"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="6dp" />

    </LinearLayout>

</FrameLayout>
