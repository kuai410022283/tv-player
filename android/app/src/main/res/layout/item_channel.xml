<?xml version="1.0" encoding="utf-8"?>
<!-- 电视家风格频道列表项 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_channel_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:background="@drawable/selector_channel_item"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- 正在播放指示器 -->
    <View
        android:id="@+id/viewPlaying"
        android:layout_width="3dp"
        android:layout_height="32dp"
        android:background="@color/accent"
        android:visibility="gone" />

    <!-- 序号 -->
    <TextView
        android:id="@+id/tvChannelIndex"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/item_channel_text_index"
        android:textStyle="bold"
        android:fontFamily="monospace"
        tools:text="001" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:scaleType="fitCenter"
        android:layout_marginEnd="10dp"
        android:visibility="gone" />

    <!-- 频道名称 + 节目信息 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <com.mediaplayer.app.ui.widget.MarqueeTextView
            android:id="@+id/tvChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/item_channel_text_primary"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            tools:text="CCTV-1 综合" />

        <com.mediaplayer.app.ui.widget.MarqueeTextView
            android:id="@+id/tvCurrentEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/item_channel_text_secondary"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:scrollHorizontally="true"
            tools:text="当前节目" />

        <ProgressBar
            android:id="@+id/progressEpgItem"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="#33FFFFFF"
            android:visibility="gone"
            tools:progress="60"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- 码流类型角标 -->
    <TextView
        android:id="@+id/tvStreamTypeBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/item_channel_text_secondary"
        android:background="@drawable/bg_badge"
        android:paddingHorizontal="4dp"
        android:paddingVertical="1dp"
        android:visibility="gone"
        tools:text="HLS"
        tools:visibility="visible" />

    <!-- 收藏图标 -->
    <ImageView
        android:id="@+id/ivFavorite"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_star"
        android:visibility="gone" />

</LinearLayout>
