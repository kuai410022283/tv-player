<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_epg_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:focusable="true"
    android:background="@drawable/selector_channel_item">

    <TextView
        android:id="@+id/tvEpgTime"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="19:00"
        android:textColor="#FFFFFF"
        android:textSize="@dimen/item_epg_text_time"
        android:textStyle="bold" />

    <com.mediaplayer.app.ui.widget.MarqueeTextView
        android:id="@+id/tvEpgTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="精彩节目"
        android:textColor="#DDDDDD"
        android:textSize="@dimen/item_epg_text_title"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:scrollHorizontally="true"
        android:singleLine="true" />
        
    <ImageView
        android:id="@+id/ivCatchup"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_replay"
        android:visibility="gone" />
        
</LinearLayout>
