# ============================================================
# 本地 Release 签名配置模板
# 使用方法：
#   1. 将此文件复制为 keystore.properties（去掉 .template 后缀）
#   2. 填写你的实际路径和密码
#   3. keystore.properties 已在 .gitignore 中，不会被提交
# ============================================================

# Keystore 文件的完整本地路径（使用正斜杠 / 或双反斜杠 \\）
KEYSTORE_PATH=D:/path/to/your/release.keystore

# Keystore 文件密码（与 GitHub Secret: ANDROID_KEYSTORE_PASSWORD 相同）
KEYSTORE_PASSWORD=your_store_password

# Key 别名（与 GitHub Secret: ANDROID_KEY_ALIAS 相同）
KEY_ALIAS=your_key_alias

# Key 密码（与 GitHub Secret: ANDROID_KEY_PASSWORD 相同）
KEY_PASSWORD=your_key_password
